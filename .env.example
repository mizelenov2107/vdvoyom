# Адрес мини-приложения, без слеша на конце
PUBLIC_URL=https://vdvoyom.example.com
# Токен бота от @BotFather и его имя без @
BOT_TOKEN=
BOT_USERNAME=
# polling (по умолчанию) или webhook
BOT_MODE=polling
# Любая случайная строка: openssl rand -hex 24
WEBHOOK_SECRET=
# Ключ для /admin (бот-помощник владельца читает отзывы). Пусто — /admin выключен
ADMIN_TOKEN=
# Кто видит админку в приложении: telegram id через запятую
ADMIN_IDS=
# Поддержка: @username и id чата владельца для пересылки обращений
SUPPORT=
SUPPORT_CHAT_ID=
# Оплата «Вдвоём+» через ЮKassa (пусто — оплата не подключена)
PLUS=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPTS=
# Реквизиты продавца и оператора персональных данных для юридических страниц
SELLER=
SELLER_EMAIL=
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
OPERATOR_RKN=
# Распознавание расписания по фото: Yandex Cloud (YandexGPT + Vision OCR)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
SCHEDULE_AI_MODEL=yandexgpt/latest
OCR_MODEL=page
AI_MONTH_LIMIT_RUB=1000
